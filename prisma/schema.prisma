// Budget Wise — Prisma schema (SQLite)
//
// The personal-finance domain of the reference app (budget-wiser.base44.app):
// login users, money transactions (income/expense with category + optional
// description), and monthly per-category budgets. The User row doubles as
// the Profile surface (currency, about-me, savings goal, avatar photo).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#0f172a")
  // Profile photo (uploads API round-trip). Null = never uploaded — the
  // slate initial fallback renders, exactly like the reference.
  photoUrl     String?
  role         String   @default("user") // user | admin
  // ---- Preferences (the reference's Profile page) ----------------------
  currency     String   @default("USD") // USD | EUR | GBP | CAD | AUD
  aboutMe      String?  // 0..120 chars (the reference's live counter)
  savingsGoal  Float?   // monthly savings goal, display currency units
  // ---- Auth machinery (carried over from the CRM scaffold verbatim) ----
  // The reset funnel: a NULL resetToken means "no reset pending"; the
  // column stores hashResetToken(token) — the SHA-256 hex of the raw
  // token, hashed at rest — consumed atomically, single-use, 60-minute TTL.
  verificationCodeHash   String?
  verificationAttempts   Int       @default(0)
  verificationExpiresAt  DateTime?
  tokenVersion           Int       @default(0)
  resetToken             String?
  resetTokenExpiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String   @id @default(cuid())
  type        String // income | expense (raw value; label maps in the UI)
  amount      Float // display currency units (not minor units)
  category    String // raw value from EXPENSE_CATEGORIES / INCOME_CATEGORIES
  date        DateTime // the transaction DAY (time-of-day zeroed on write)
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, category])
}

model Budget {
  id           String   @id @default(cuid())
  category     String // an EXPENSE_CATEGORIES raw value
  monthlyLimit Float
  month        Int // 1..12
  year        Int
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
  @@index([userId, year, month])
}
